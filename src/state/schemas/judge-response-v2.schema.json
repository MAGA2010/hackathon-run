{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maga2010.github.io/hackathon-run/schemas/judge-response-v2.schema.json",
  "title": "Judge Response v2",
  "type": "object",
  "required": ["protocol", "dimensions"],
  "additionalProperties": false,
  "properties": {
    "protocol": { "const": "hackathon-run.judge.v2" },
    "request_id": { "type": "string" },
    "model": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "dimensions": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["name", "score", "rationale", "confidence"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "enum": [
              "problem_clarity",
              "originality",
              "completeness",
              "technical_depth",
              "demo_quality",
              "business_value",
              "submission_readiness"
            ]
          },
          "score": { "type": "number", "minimum": 0, "maximum": 5 },
          "rationale": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "value"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": ["command", "url", "test", "browser", "manual", "log"]
                },
                "value": { "type": "string", "minLength": 1 }
              }
            }
          },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
          "judge_questions": {
            "type": "array",
            "items": { "type": "string" }
          },
          "improvements": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    },
    "overall": { "type": "number", "minimum": 0, "maximum": 5 }
  }
}
