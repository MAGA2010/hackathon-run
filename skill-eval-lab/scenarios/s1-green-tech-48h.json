  "expected_skills": [
    "idea-clarify",
    "scope-knife",
    "time-box",
    "stack-picker",
    "prize-strategy",
    "demo-coach",
    "judge-sim",
    "ship-pack"
  ],
  "project": {
    "name": "GreenFork",
    "files": {
