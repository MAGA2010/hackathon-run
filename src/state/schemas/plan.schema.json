{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://hackathon-surgeon.dev/schemas/plan.schema.json",
  "title": "Hackathon Plan",
  "description": "Output of scope-knife. Lists every feature with its KEEP/CUT/DEFER classification, the demo path, and a prioritized next-steps task list.",
  "type": "object",
  "required": ["version", "generated_at", "demo_goal", "time_remaining_minutes", "features", "demo_path", "next_tasks"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 UTC timestamp of plan generation."
    },
    "demo_goal": {
      "type": "string",
      "minLength": 1,
      "description": "One-sentence description of what judges should see at the end of the demo."
    },
    "time_remaining_minutes": {
      "type": "integer",
      "minimum": 0,
      "description": "Estimated minutes left in the hackathon."
    },
    "features": {
      "type": "array",
      "description": "Every considered feature, classified.",
      "items": {
        "type": "object",
        "required": ["name", "status", "classification"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "status": {
            "enum": ["implemented", "half-implemented", "unimplemented", "broken"],
            "description": "Current implementation status."
          },
          "classification": {
            "enum": ["KEEP", "CUT", "DEFER"],
            "description": "Scope-knife decision."
          },
          "rationale": {
            "type": "string",
            "description": "One-line reason for the classification."
          },
          "time_estimate_minutes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "demo_path": {
      "type": "array",
      "maxItems": 5,
      "description": "Linear sequence of steps the demo follows.",
      "items": {
        "type": "object",
        "required": ["step", "action", "expected_outcome"],
        "additionalProperties": false,
        "properties": {
          "step": { "type": "integer", "minimum": 1 },
          "action": { "type": "string", "minLength": 1 },
          "expected_outcome": { "type": "string", "minLength": 1 }
        }
      }
    },
    "next_tasks": {
      "type": "array",
      "description": "Prioritized task list. P0 = critical path, P1 = polish, P2 = nice-to-have.",
      "items": {
        "type": "object",
        "required": ["priority", "task", "estimate_minutes"],
        "additionalProperties": false,
        "properties": {
          "priority": { "enum": ["P0", "P1", "P2"] },
          "task": { "type": "string", "minLength": 1 },
          "estimate_minutes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "examples": [
    {
      "version": "1.0",
      "generated_at": "2025-04-19T08:00:00Z",
      "demo_goal": "A user signs up and saves their first note.",
      "time_remaining_minutes": 240,
      "features": [
        {"name": "Auth", "status": "implemented", "classification": "KEEP",
         "rationale": "Core demo path.", "time_estimate_minutes": 30},
        {"name": "Notes CRUD", "status": "half-implemented", "classification": "KEEP",
         "rationale": "Core demo path.", "time_estimate_minutes": 90},
        {"name": "Search", "status": "unimplemented", "classification": "CUT",
         "rationale": "Off demo path.", "time_estimate_minutes": 120},
        {"name": "Dark mode", "status": "unimplemented", "classification": "DEFER",
         "rationale": "Polish, not critical.", "time_estimate_minutes": 60}
      ],
      "demo_path": [
        {"step": 1, "action": "Open the app URL.",
         "expected_outcome": "Landing page renders."},
        {"step": 2, "action": "Click Sign Up.",
         "expected_outcome": "Auth modal opens."},
        {"step": 3, "action": "Save a note.",
         "expected_outcome": "Note appears in list."}
      ],
      "next_tasks": [
        {"priority": "P0", "task": "Finish Notes CRUD.", "estimate_minutes": 90},
        {"priority": "P1", "task": "Polish Auth.", "estimate_minutes": 30}
      ]
    }
  ]
}
