{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maga2010.github.io/hackathon-run/schemas/sprint.schema.json",
  "title": "Sprint Contract",
  "description": "Agreed definition of done for one feature before the generator writes code.",
  "type": "object",
  "required": ["version", "generated_at", "name", "goal", "feature", "status", "criteria"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "name": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "feature": { "type": "string", "minLength": 1 },
    "status": {
      "enum": [
        "proposed",
        "approved",
        "in_progress",
        "pending_review",
        "passed",
        "failed",
        "blocked"
      ],
      "description": "Lifecycle of the sprint contract."
    },
    "definition_of_done": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "passes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "passes": { "type": "boolean", "default": false },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "value"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": ["command", "url", "test", "browser", "manual", "log"]
                },
                "value": { "type": "string", "minLength": 1 },
                "at": { "type": "string", "format": "date-time" }
              }
            }
          },
          "note": { "type": "string" }
        }
      }
    },
    "verdict": {
      "enum": ["pass", "fail", "pending"]
    },
    "feedback": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "iterations": { "type": "integer", "minimum": 0, "default": 0 },
    "budget_minutes": { "type": "integer", "minimum": 0 },
    "max_iterations": { "type": "integer", "minimum": 1 }
  }
}
