{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://maga2010.github.io/hackathon-run/schemas/eval.schema.json",
  "title": "Evaluator Verdict",
  "description": "Output of the separate evaluator agent. Read-only, evidence-first, and default-skeptical.",
  "type": "object",
  "required": ["version", "generated_at", "sprint", "verdict", "criteria", "feedback"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": "1.0" },
    "generated_at": { "type": "string", "format": "date-time" },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "sprint": { "type": "string", "minLength": 1 },
    "evaluator": { "type": "string" },
    "verdict": {
      "enum": ["pass", "fail", "blocked", "pending"]
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "passes"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "passes": { "type": "boolean" },
          "score": { "type": "integer", "minimum": 0, "maximum": 5 },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["kind", "value"],
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": ["command", "url", "test", "browser", "manual", "log"]
                },
                "value": { "type": "string", "minLength": 1 },
                "at": { "type": "string", "format": "date-time" }
              }
            }
          },
          "note": { "type": "string" }
        }
      }
    },
    "feedback": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "iterations": { "type": "integer", "minimum": 0 },
    "budget_minutes": { "type": "integer", "minimum": 0 }
  }
}
