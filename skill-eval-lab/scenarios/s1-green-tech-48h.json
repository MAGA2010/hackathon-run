      "package.json": "{\n  \"name\": \"green-fork\",\n  \"version\": \"0.1.0\",\n  \"scripts\": {\n    \"dev\": \"vite\"\n  }\n}\n",
      "src/predict.py": "def predict_surplus(menu, weather):\n    return []\n",
      "src/menu.py": "def fetch_menu():\n    return []\n",
      "src/user.py": "def get_profile(user_id):\n    return {}\n",
      "src/prebook.py": "def prebook_meal(user_id, meal_id):\n    return True\n",
      ".env.example": "DATABASE_URL=postgres://localhost/greenfork\n",
      "prizes.json": "[\n  {\n    \"name\": \"Best Sustainability\",\n    \"criteria\": \"reduce waste sustainability impact circular measurable\",\n    \"weight\": 3\n  },\n  {\n    \"name\": \"Best AI Use\",\n    \"criteria\": \"ai machine learning generative useful model\",\n    \"weight\": 2\n  },\n  {\n    \"name\": \"Best UX\",\n    \"criteria\": \"design usability delight accessibility\",\n    \"weight\": 1\n  }\n]\n"
    }
  },
  "steps": [
    { "id": "init", "kind": "cli", "args": ["init", "-y"], "expect_exit": 0 },
    {
      "id": "scan",
      "kind": "python",
      "script": "skills/scope-knife/scripts/scan_repo.py",
      "args": ["{cwd}"],
      "capture": "inventory.json",
      "expect_exit": 0
    },
    {
      "id": "scope",
      "kind": "python",
      "script": "skills/scope-knife/scripts/classify.py",
      "args": [
        "--inventory",
        "{cwd}/inventory.json",
        "--demo-goal",
        "A student sees tomorrow's predicted surplus and prebooks one meal to reduce waste.",
        "--time-remaining",
        "840",
        "--out-dir",
        "{cwd}/.hackathon"
      ],
      "expect_exit": 0
    },
    {
      "id": "timebox",
      "kind": "python",
      "script": "skills/time-box/scripts/compute.py",
      "args": [
        "--time-remaining",
        "840",
        "--team-size",
        "4",
        "--current-stage",
        "build",
        "--out-dir",
        "{cwd}/.hackathon"
      ],
      "expect_exit": 0
    },
    {
      "id": "stack",
      "kind": "python",
      "script": "skills/stack-picker/scripts/pick.py",
      "args": [
        "--team-skills",
        "python,javascript,typescript,react,llm",
        "--time-remaining",
        "840",
        "--demo-format",
        "web",
        "--prize-category",
        "sustainability",
        "--out-dir",
        "{cwd}/.hackathon"
      ],
      "expect_exit": 0
    },
    {
      "id": "prize",
      "kind": "python",
      "script": "skills/prize-strategy/scripts/target.py",
      "args": [
        "--prizes",
        "{cwd}/prizes.json",
        "--project",
        "{cwd}/.hackathon/state/plan.json",
        "--team-skills",
        "python,javascript,react,llm",
        "--time-remaining",
        "840",
        "--out-dir",
        "{cwd}/.hackathon"
      ],
      "expect_exit": 0
    },
    {
      "id": "demo",
      "kind": "python",
      "script": "skills/demo-coach/scripts/coach.py",
      "args": [
        "--demo-goal",
        "A student sees tomorrow's predicted surplus and prebooks one meal to reduce waste.",
        "--duration",
        "60",
        "--audience",
        "hackathon judges",
        "--out-dir",
        "{cwd}/.hackathon"
      ],
      "expect_exit": 0
    },
    {
      "id": "judge",
      "kind": "python",
      "script": "skills/judge-sim/scripts/score.py",
      "args": ["--repo-root", "{cwd}", "--out-dir", "{cwd}/.hackathon"],
      "expect_exit": 0
    },
    {
      "id": "ship",
      "kind": "python",
      "script": "skills/ship-pack/scripts/audit.py",
      "args": ["--repo-root", "{cwd}", "--out-dir", "{cwd}/.hackathon"],
      "expect_exit": 0
    },
    {
      "id": "decision",
      "kind": "python",
      "script": "skills/decision-log/scripts/log_decision.py",
      "args": [
        "--feature",
        "Notifications",
        "--classification",
        "CUT",
        "--rationale",
        "Off demo path; removed for time.",
        "--author",
        "alice",
        "--out-dir",
        "{cwd}/.hackathon"
      ],
      "expect_exit": 0
    },
    {
      "id": "verify",
      "kind": "cli",
      "args": ["run", "fast-verify", "--apply", "-C", "{cwd}"],
      "expect_exit": 0
    },
    {
      "id": "flow-json",
      "kind": "cli",
      "args": ["flow", "--json", "-C", "{cwd}"],
      "expect_exit": 0
    },
    {
      "id": "status",
      "kind": "cli",
      "args": ["status", "--json", "-C", "{cwd}"],
      "expect_exit": 0
    },
    {
      "id": "resume",
      "kind": "cli",
      "args": ["resume", "--json", "-C", "{cwd}"],
      "expect_exit": 0
    },
    { "id": "trace", "kind": "cli", "args": ["trace", "--json", "-C", "{cwd}"], "expect_exit": 0 },
    {
      "id": "report",
      "kind": "cli",
      "args": ["report", "--json", "-C", "{cwd}"],
      "expect_exit": 0
    },
    {
      "id": "validate",
      "kind": "cli",
      "args": ["validate", "{cwd}/.hackathon/state"],
