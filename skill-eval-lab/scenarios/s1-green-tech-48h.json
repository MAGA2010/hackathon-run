    {
      "id": "plan-goal",
      "description": "plan 包含预购目标",
      "type": "text",
      "file": ".hackathon/state/plan.json",
      "op": "contains",
      "value": "prebooks"
    },
    {
      "id": "plan-features",
      "description": "plan 至少 4 个功能",
